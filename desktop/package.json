{
  "name": "qingdan-desktop-bundled",
  "productName": "Qingdan",
  "version": "1.3.5",
  "private": true,
  "main": "src/main.cjs",
  "author": "Independent Qingdan project",
  "description": "Qingdan desktop with automatic embedded local backend and optional private server",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "check": "node scripts/check.cjs && npm test",
    "package:linux:dir": "node scripts/package.cjs linux --dir",
    "package:linux:appimage": "node scripts/package.cjs linux --appimage --x64",
    "package:win:zip": "node scripts/package.cjs win --zip --x64",
    "package:mac:dir": "node scripts/package.cjs mac --dir --arm64",
    "prepare:backend": "node scripts/prepare-backend.cjs",
    "verify:backend": "node scripts/verify-backend.cjs --smoke",
    "package:mac:archives": "node scripts/package.cjs mac --arm64 --dmg --zip",
    "package:mac:x64:dir": "node scripts/package.cjs mac --dir --x64",
    "package:mac:x64:archives": "node scripts/package.cjs mac --x64 --dmg --zip"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "classic-level": "3.0.0",
    "i18next": "26.5.2"
  }
}
