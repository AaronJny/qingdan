{
  "name": "qingdan-standalone",
  "version": "1.1.1",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --import tsx server/main.ts",
    "build": "vite build && node scripts/build-server.mjs && node scripts/build-offline.mjs",
    "start": "node dist/server/main.mjs",
    "users": "node dist/server/users.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import tsx --test assets/*.test.ts lib/*.test.ts",
    "test:ui": "node --import tsx --test tests/*ui.test.tsx",
    "test:server": "node --import tsx --test server/*.test.ts",
    "test:licenses": "node --test scripts/license-plugin.test.mjs",
    "check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "ical.js": "2.2.1",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "happy-dom": "^20.14.5",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "esbuild": "0.28.0"
  },
  "type": "module"
}
